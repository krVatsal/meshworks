# Database (MongoDB Atlas or local)
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/
DB_NAME=model_discovery_db

# CORS
CORS_ORIGINS=*

# AI / Search
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key
SKETCHFAB_API_KEY=your_sketchfab_api_key

# Blender MCP / Azure OpenAI
API_KEY=your_azure_openai_key
GLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
GLM_MODEL=gpt-5-mini
GLB_OUTPUT_DIR=/app/exports

# Mesh Generation API
MESH_GENERATOR_URL=http://98.70.40.74:8000/generate-mesh

# Storage & LRU Cache Settings (4GB hard cap)
MAX_CACHE_MB=4096
